# Polymarket Trader - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true
LOG_LEVEL=INFO

# FastAPI app title/version (app/main.py, `title=`/`version=`) -- cosmetic
# only, no strategy or fence code reads these.
# APP_NAME=Polymarket Trader
# APP_VERSION=0.1.0

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL connection (used by Docker Compose and application)
POSTGRES_USER=polymarket
POSTGRES_PASSWORD=polymarket
POSTGRES_DB=polymarket

# Full database URL (for local development without Docker)
DATABASE_URL=postgresql+asyncpg://polymarket:polymarket@localhost:5432/polymarket

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379

# Celery configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# POLYMARKET API
# =============================================================================
# Your Polygon wallet private key (without 0x prefix)
# IMPORTANT: Never commit your private key to version control!
POLYMARKET_PRIVATE_KEY=

# Your wallet address (funder address for orders)
POLYMARKET_FUNDER_ADDRESS=

# API credentials (obtained from CLOB client)
# These can be derived from your private key or set manually
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# How long (seconds) app.venues.polymarket.adapter.PolymarketAdapter may
# serve a memoized market-metadata/event-grouping lookup -- get_book is
# FOUR HTTP requests, not one (a market lookup plus an events listing
# fanning out from it), so this bounds how often those are repeated
# within one scan pass. Order books themselves are NEVER memoized at any
# TTL, only market metadata and event grouping. 0.0 disables memoization
# entirely (every call re-fetches).
# POLYMARKET_MARKET_CACHE_TTL_S=60.0

# =============================================================================
# KALSHI TRADE API v2
# =============================================================================
# app/venues/kalshi/ (T12). Docs: https://docs.kalshi.com (Trade API v2);
# the facts this adapter relies on were pinned in PLAN.md §3 on
# 2026-09-04 and are not re-fetched (GUARDRAILS.md §1.4).

# API key id (a public identifier, safe to commit in an example file).
KALSHI_API_KEY_ID=

# RSA private key, PEM-encoded, used to sign every request (RSA-PSS,
# SHA-256, MGF1-SHA256, salt length = digest length).
# IMPORTANT: never commit this. `.gitignore` already covers `.env`,
# `*.pem` and `*.key` — do not weaken it (GUARDRAILS.md §1.3).
# Multi-line PEMs go in quotes with literal \n escapes, e.g.
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
KALSHI_PRIVATE_KEY_PEM=

# Which Kalshi environment to talk to. Defaults to `demo` — production
# is opt-in, the same way TRADING_MODE defaults to `paper`.
#   demo -> https://external-api.demo.kalshi.co/trade-api/v2
#   prod -> KALSHI_BASE_URL below
# KALSHI_ENV=demo

# Production base URL. Setting this to anything other than the default
# overrides KALSHI_ENV entirely (use it for the alternate production host
# https://api.elections.kalshi.com/trade-api/v2, or a proxy).
# KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# =============================================================================
# COSTS
# =============================================================================
# Fee models and cost settings (app/venues/fees.py, T05; PLAN.md §3 Venue
# facts). Fees are never literals in strategy code (GUARDRAILS.md §1.5) —
# these are the only place fee/cost numbers should be tuned.

# Kalshi standard retail fee rates (dimensionless). NOT re-confirmed
# against the live Kalshi fee page on 2026-09-04 (GUARDRAILS.md §1.4
# forbids re-fetching vendor docs from task code); 0.07 is Kalshi's
# historically published standard taker rate. Maker is 0 by default,
# though some series carry a nonzero maker fee (PLAN.md §3).
# KALSHI_TAKER_FEE_RATE=0.07
# KALSHI_MAKER_FEE_RATE=0.0

# Per-category override for Polymarket taker fee rates, as a JSON object
# keyed by lowercased category name, e.g. {"crypto": 0.08}. Overrides
# app/venues/fees.py::POLYMARKET_CATEGORY_TAKER_RATES for the categories
# named; any category not named here keeps the code default. An
# override that lands on exactly 0.0 (e.g. {"politics": 0.0}) is still
# honored as a real rate, but -- unlike the published table's own
# genuine zeros (Geopolitics) -- it is flagged in a backtest result's
# `undeclared_zero_fee_markets`, because a zero an operator TYPED is not
# the same assertion as a zero the venue PUBLISHED.
# POLYMARKET_TAKER_FEE_OVERRIDES={}

# Polygon gas (USD) to redeem a winning Polymarket position after
# resolution (PLAN.md §3: user pays no gas per trade, only for
# deposit/withdrawal and redemption; small, ~$0.01-0.05).
# REDEMPTION_GAS_USD=0.05

# Hours for a USD transfer between venues to settle (ACH/wire; Kalshi
# capital is not fungible with Polymarket USDC in real time, PLAN.md §3).
# TRANSFER_LATENCY_HOURS=72

# USD cost to move capital between venues.
# TRANSFER_COST_USD=5.0

# Multiplier on a market's 24h volume used to INVENT order-book depth
# when a snapshot carries only top-of-book quotes and no recorded book
# (app/execution/fill_engine.py::synthesize_book,
# size = LIQUIDITY_FRACTION * volume_24h / price). This is NOT a
# fraction of depth that was actually observed -- there is no visible
# depth in that case -- it is the assumption standing in for it, so a
# larger value fabricates more fillable size exactly where none was
# ever seen.
# LIQUIDITY_FRACTION=0.02

# Hours-to-close below which a market is treated as "near resolution"
# (fees vanish toward the tails; see app/venues/fees.py module docstring).
# NEAR_RESOLUTION_HOURS=72

# Hours between a market RESOLVING (not closing) and its payout becoming
# spendable cash. Applied from `resolved_at`, not from the market's
# close time -- a market can sit closed-but-unresolved for a while
# before that clock even starts (app/services/backtesting/engine.py
# `_settle_position`/`_release_settlements`).
# SETTLEMENT_DELAY_HOURS=24

# Minimum hours-to-resolution required before annualizing a return (an
# edge with less time than this is not annualized -- too noisy).
# MIN_HOURS_FOR_ANNUALIZATION=6

# Minimum annualized return (dimensionless fraction) for an edge to be
# considered viable after costs.
# MIN_VIABLE_ANNUALIZED=0.05

# Minimum USD notional (size_contracts * limit_price, summed across an
# intent's legs) the backtest/paper fill path will attempt for one
# intent; below this the intent is rejected as dust rather than filled
# (app/services/backtesting/engine.py, app/config.py). A strategy's own
# position-size default must be sized so it clears this floor at the
# lowest price the strategy will ever signal at -- see
# app/strategies/binary_complement_arbitrage.py and
# app/strategies/multi_outcome_bundle_arbitrage.py for worked examples.
# MIN_TRADE_USD=10.0

# =============================================================================
# LIVE-TRADING FENCE -- READ BEFORE CHANGING (app/execution/fences.py, PLAN.md D13)
# =============================================================================
# These two are UNCOMMENTED deliberately, unlike every other setting in this
# file: they are the safety-critical keys, and an operator who copies this
# file to `.env` must land in paper mode EXPLICITLY, not by relying on a
# code default they cannot see here.
#
# TRADING_MODE must be "paper" or "live". Constructing a live venue adapter
# (real order placement) additionally requires LIVE_TRADING_CONFIRMATION
# below to equal the exact phrase "I_UNDERSTAND_REAL_MONEY" -- setting
# TRADING_MODE=live alone is NOT enough, and is deliberately not enough, so
# a stray edit to this one line can never arm real-money trading by itself.
TRADING_MODE=paper

# Must be set to exactly I_UNDERSTAND_REAL_MONEY, in addition to
# TRADING_MODE=live above, before any real order can ever be placed.
# Leave this blank to stay in paper mode regardless of TRADING_MODE.
LIVE_TRADING_CONFIRMATION=

# Kill switch: if a file exists at this path (relative to the backend
# process's working directory, or an absolute path), ALL live order
# placement is refused, regardless of TRADING_MODE/LIVE_TRADING_CONFIRMATION
# above -- only the file's EXISTENCE matters, never its contents. Remove the
# file to re-arm live trading.
# KILL_SWITCH_PATH=TRADING_KILL_SWITCH

# Per-order and per-account USD risk limits, enforced by
# app/execution/fences.py::check_order_limits() for BOTH paper and live
# orders (not only once real money is at risk).
# MAX_ORDER_NOTIONAL_USD=250
# MAX_DAILY_LOSS_USD=100
# MAX_OPEN_NOTIONAL_USD=1000
# MAX_NEAR_RESOLUTION_NOTIONAL_USD=500

# =============================================================================
# ORDER ROUTING (app/execution/{ledger,router,reconcile}.py)
# =============================================================================
# Starting capital for PAPER mode, PER VENUE. There is deliberately no
# single "starting capital" number: capital is not fungible across venues
# (Kalshi funds sit in a CFTC-regulated FCM account settling by ACH/wire
# in days -- see TRANSFER_LATENCY_HOURS above), so a two-venue trade is
# bounded by the POORER venue, never by the total. Keys must be
# "polymarket"/"kalshi"; an unknown key is rejected at startup rather
# than silently leaving a venue with no capital.
# PAPER_STARTING_BALANCES={"polymarket": 1000.0, "kalshi": 1000.0}

# How long (seconds) a locally-persisted PENDING order may sit with no
# venue record before reconciliation marks it FAILED with reason
# "no_ack". The order row is written BEFORE the venue is called (so a
# crash leaves a recoverable record), which makes "no venue record" the
# normal state while a request is in flight; this is how long that stays
# plausible. Keep it comfortably longer than the 60s reconcile interval.
# RECONCILE_GRACE_S=120

# Fraction of a leg's requested size that must fill for an
# atomicity="all_or_none" intent to count as whole. Below this on ANY
# leg, the legs that DID fill are sold back -- which crosses the spread
# twice and pays two taker fees, i.e. it is a realized loss, not a free
# undo. Lowering this tolerates more leg imbalance; raising it unwinds
# more often.
# ALL_OR_NONE_FILL_TOLERANCE=0.995

# How many ticks below the current best bid an unwind SELL's limit is
# placed (above the best ask for an unwind BUY). This is not slippage
# paid -- fills happen at the book's own level prices -- it is how far
# down the book an unwind is willing to reach before giving up and
# leaving a loudly-logged naked position. 0 only ever hits the touch; a
# large value approaches an unbounded market order.
# UNWIND_SLIPPAGE_TICKS=5

# =============================================================================
# DISCOVERY -- SCANNER, LINK PROPOSAL, BOOK COLLECTION
# =============================================================================
# Periodic tasks (app/services/{scoring,scanner,matching}.py,
# app/tasks/{scanner,matching}.py, app/services/data_collector.py). These
# beats find and record opportunities; they never route an order
# themselves -- app/execution/router.py is the only path to a venue call.

# How many markets PER VENUE app.services.scanner.scan() reads a book for
# and runs strategies against per pass, ranked by volume. Unbounded
# scanning would mean walking a book for every open market on both
# venues every SCAN_INTERVAL_S, most of which have no volume worth
# scoring.
# SCAN_TOP_N=200

# How many app.services.scanner.scan() get_book calls may be in flight
# at once, summed across every venue's adapter (one shared semaphore,
# not one per venue). Keeps a pass from opening hundreds of sockets at
# once against a venue's rate limit.
# SCAN_BOOK_FETCH_CONCURRENCY=20

# Celery beat period (seconds) for app.tasks.scanner.scan_opportunities.
# SCAN_INTERVAL_S=120

# Celery beat period (seconds) for app.tasks.scanner.scan_near_resolution
# (app.services.scanner.near_resolution_pass) -- kept separate from
# SCAN_INTERVAL_S because a settlement-edge trade is a capital-lockup
# position held for hours-to-days, so re-deriving it every couple of
# minutes discovers the same rows over and over.
# NEAR_RESOLUTION_SCAN_INTERVAL_S=300

# Cushion (basis points of the limit price) app.services.scoring.score()
# allows a leg's fill price to exceed (BUY) or undercut (SELL) its limit
# by before that fill stops counting toward
# OpportunityScore.fill_confidence.
# MAX_SLIPPAGE_BPS=50

# Celery beat period (seconds) for
# app.tasks.matching.propose_event_links (app.services.matching.
# propose_links). Proposes candidate cross-venue links only -- approval
# stays a human act in app/api/routes/links.py; nothing trades on a
# proposed link.
# LINK_PROPOSAL_INTERVAL_S=3600

# How stale (seconds) a recorded BookSnapshot may be and still stand in
# for a replayed PriceHistory row's book
# (app.services.backtesting.data_replay.DataReplayer). Outside this
# window (or when no snapshot exists), the replayer falls back to
# synthesize_book and the result is labeled
# depth_source="synthetic"/"mixed" accordingly.
# BOOK_MATCH_WINDOW_S=120

# How many markets PER VENUE app.services.data_collector.DataCollector.
# collect_books fetches a book for per call, ranked by the same volume
# proxy SCAN_TOP_N documents above.
# BOOK_COLLECTION_TOP_N=50

# =============================================================================
# FRONTEND
# =============================================================================
# API URL for frontend (Vite environment variable)
VITE_API_URL=http://localhost:8000/api/v1

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================
# CORS origins (comma-separated list)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database connection pool settings
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# Polymarket API endpoints (defaults are usually fine)
# CLOB_API_URL=https://clob.polymarket.com
# GAMMA_API_URL=https://gamma-api.polymarket.com
# CHAIN_ID=137
